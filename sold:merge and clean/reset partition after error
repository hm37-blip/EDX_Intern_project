import os
import shutil
import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq

path_sold_csv = r'C:\Users\Manzh\OneDrive\桌面\edx\Cleaned_Sold_Data.csv'
parquet_root = r'C:\Users\Manzh\OneDrive\桌面\edx\Sold_Data_Partitioned'

def force_rebuild():
    
    if os.path.exists(parquet_root):
        shutil.rmtree(parquet_root)
  
    df = pd.read_csv(path_sold_csv)
    
    table = pa.Table.from_pandas(df)
    pq.write_to_dataset(table, root_path=parquet_root, partition_cols=['City'])

force_rebuild()
